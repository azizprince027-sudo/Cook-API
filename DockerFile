# 1. Image de départ :  avec Node 22 //Alpine est un Linux très léger
FROM node:22-alpine

# 2. Installer Bun dans l'image
RUN npm install -g bun

# 3. Dossier de travail dans le conteneur
WORKDIR /app

# 4. Copie  uniquement des fichiers de dépendances
COPY package.json bun.lock ./

# 5. Installer les dépendances exactement comme dans bun.lock
RUN bun install --frozen-lockfile

# 6. Copier tout le reste du projet
COPY . .

# 7. Générer le client Prisma (avec fichie de config)
RUN bunx prisma generate --config prisma7.config.ts

# 8. Compiler le TypeScript vers dist/ | lance nest build et produit dist/main.js
RUN bun run build

# 9. le port de l'API
EXPOSE 3000

# 10. Lancement de l'API compilée au démarrage du conteneur
CMD ["bun", "run", "start:prod"]
